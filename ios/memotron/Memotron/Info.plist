					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
				</dict>
			</dict>
		</dict>
	<key>NucleusAccountDomain</key>
	<string>nucleum.app</string>
	<key>NucleusAppEnvironment</key>
	<string>dev</string>
	<key>NucleusDebugSinkUrl</key>
	<string>https://nucleus-debug-sink.21n.workers.dev</string>
	<key>NucleusDefaultRegion</key>
	<string>insouth</string>
	<key>NucleusProduct</key>
	<string>memotron.app</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
