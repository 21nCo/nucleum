{
  "name": "@21n/nucleus",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "extensions/*",
    "services/*",
    "client/stores",
    "client/components",
    "client/elements",
    "client/types",
    "client/utils",
    "client/actions",
    "client/products",
    "client/static",
    "client/layout",
    "client/persistence",
    "client/landing",
    "client/extensions",
    "client/branding",
    "client/icons",
    "client/theme",
    "client/legacy",
    "client/data",
    "client/illustrations",
    "client/iconsV2",
    "client/cx",
    "shared/types",
    "shared/utils",
    "shared/dbo",
    "tests"
  ],
  "dependencies": {
    "@carbon/charts": "1.22.18",
    "@carbon/charts-svelte": "1.22.18",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "1.3.34"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/markdown-it": "^14.1.2",
    "@tsconfig/svelte": "^5.0.5",
    "cookie": "^0.6.0",
    "mrmime": "^2.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "sade": "^1.8.1",
    "sirv": "^3.0.1",
    "svelte": "^5.55.0",
    "svelte-preprocess": "^5.1.1",
    "ts-morph": "^22.0.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.1",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.5"
  },
  "scripts": {
    "build": "turbo run build",
    "check:apps": "node tools/check/run-app-checks.mjs --format=json",
    "dev": "turbo run dev --parallel",
    "dev:nucleus": "turbo run dev --filter=nucleus-app",
    "dev:memotron": "turbo run dev --filter=memotron-app",
    "dev:gathery": "turbo run dev --filter=gathery-app",
    "dev:pointron": "turbo run dev --filter=pointron-app",
    "dev:memotron-share": "turbo run dev --filter=memotron-share",
    "dev:memotron-clipper": "turbo run dev --filter=memotron-clipper",
    "codemod:alias": "tsx tools/codemods/alias-migration/index.ts",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=tidigit-tests",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:products": "turbo run build --filter='./apps/*'",
    "build:nucleus": "turbo run build --filter=nucleus-app",
    "build:memotron": "turbo run build --filter=memotron-app",
    "build:pointron": "turbo run build --filter=pointron-app",
    "build:ios": "npm run build:ios:nucleum && npm run build:ios:memotron && npm run build:ios:pointron",
    "build:ios:nucleum": "node tools/ios/build-web-bundle.mjs nucleum",
    "build:ios:memotron": "node tools/ios/build-web-bundle.mjs memotron",
    "build:ios:pointron": "node tools/ios/build-web-bundle.mjs pointron",
    "setup:ios:whisper": "node tools/ios/setup-whisper.mjs",
    "build:memotron-share": "turbo run build --filter=memotron-share",
    "clean": "turbo run clean"
  },
  "packageManager": "npm@10.0.0",
  "overrides": {
    "@parcel/watcher": "2.1.0"
  }
}
