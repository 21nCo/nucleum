{
  "name": "tidigit",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "extensions/*",
    "services/*",
    "client/stores",
    "client/components",
    "client/elements",
    "client/types",
    "client/utils",
    "client/actions",
    "client/products",
    "client/static"
  ],
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.5",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:nucleus": "turbo run dev --filter=nucleus-app",
    "dev:memotron": "turbo run dev --filter=memotron-app",
    "dev:gathery": "turbo run dev --filter=gathery-app",
    "dev:pointron": "turbo run dev --filter=pointron-app",
    "dev:memotron-share": "turbo run dev --filter=memotron-share",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:products": "turbo run build --filter='./apps/*'",
    "build:nucleus": "turbo run build --filter=nucleus-app",
    "build:memotron": "turbo run build --filter=memotron-app",
    "build:pointron": "turbo run build --filter=pointron-app",
    "build:memotron-share": "turbo run build --filter=memotron-share",
    "clean": "turbo run clean"
  },
  "packageManager": "npm@10.0.0"
}
