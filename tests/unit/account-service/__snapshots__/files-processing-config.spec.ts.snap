// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`account Worker config for file processing > renders the queue, consumer, container and cron for every region in both mode > dev both 1`] = `
{
  "dev-euwest": "FILEFN_PROCESSING_MODE = "both"
[env.dev-euwest.triggers]
crons = ["0 * * * *"]

[[env.dev-euwest.queues.producers]]
binding = "FILEFN_PROCESSING_QUEUE"
queue = "nucleus-account-dev-euwest-file-processing"

[[env.dev-euwest.queues.consumers]]
queue = "nucleus-account-dev-euwest-file-processing"
max_batch_size = 1
max_concurrency = 2
max_retries = 3
retry_delay = 30
dead_letter_queue = "nucleus-account-dev-euwest-file-processing-dlq"

[[env.dev-euwest.containers]]
class_name = "FileProcessingContainer"
image = "../../file-processing/Dockerfile"
image_build_context = "../../.."
max_instances = 1
instance_type = "standard-1"

[[env.dev-euwest.durable_objects.bindings]]
name = "FILEFN_PROCESSING_CONTAINER"
class_name = "FileProcessingContainer"

[[env.dev-euwest.migrations]]
tag = "v1-file-processing-container"
new_sqlite_classes = ["FileProcessingContainer"]

[[env.dev-euwest.secrets_store_secrets]]
binding = "FILEFN_PROCESSING_DATABASE_URL"
store_id = "REPLACE_WITH_21N_DEV_SECRETS_STORE_ID"
secret_name = "NUCLEUS_ACCOUNT_DEV_EUWEST_FILEFN_PROCESSING_DATABASE_URL"",
  "dev-insouth": "FILEFN_PROCESSING_MODE = "both"
[env.dev-insouth.triggers]
crons = ["0 * * * *"]

[[env.dev-insouth.queues.producers]]
binding = "FILEFN_PROCESSING_QUEUE"
queue = "nucleus-account-dev-insouth-file-processing"

[[env.dev-insouth.queues.consumers]]
queue = "nucleus-account-dev-insouth-file-processing"
max_batch_size = 1
max_concurrency = 2
max_retries = 3
retry_delay = 30
dead_letter_queue = "nucleus-account-dev-insouth-file-processing-dlq"

[[env.dev-insouth.containers]]
class_name = "FileProcessingContainer"
image = "../../file-processing/Dockerfile"
image_build_context = "../../.."
max_instances = 1
instance_type = "standard-1"

[[env.dev-insouth.durable_objects.bindings]]
name = "FILEFN_PROCESSING_CONTAINER"
class_name = "FileProcessingContainer"

[[env.dev-insouth.migrations]]
tag = "v1-file-processing-container"
new_sqlite_classes = ["FileProcessingContainer"]

[[env.dev-insouth.secrets_store_secrets]]
binding = "FILEFN_PROCESSING_DATABASE_URL"
store_id = "REPLACE_WITH_21N_DEV_SECRETS_STORE_ID"
secret_name = "NUCLEUS_ACCOUNT_DEV_INSOUTH_FILEFN_PROCESSING_DATABASE_URL"",
  "dev-useast": "FILEFN_PROCESSING_MODE = "both"
[env.dev-useast.triggers]
crons = ["0 * * * *"]

[[env.dev-useast.queues.producers]]
binding = "FILEFN_PROCESSING_QUEUE"
queue = "nucleus-account-dev-useast-file-processing"

[[env.dev-useast.queues.consumers]]
queue = "nucleus-account-dev-useast-file-processing"
max_batch_size = 1
max_concurrency = 2
max_retries = 3
retry_delay = 30
dead_letter_queue = "nucleus-account-dev-useast-file-processing-dlq"

[[env.dev-useast.containers]]
class_name = "FileProcessingContainer"
image = "../../file-processing/Dockerfile"
image_build_context = "../../.."
max_instances = 1
instance_type = "standard-1"

[[env.dev-useast.durable_objects.bindings]]
name = "FILEFN_PROCESSING_CONTAINER"
