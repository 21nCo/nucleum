{
  "name": "memotron-share",
  "version": "0.1.0",
  "build": 1,
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5300",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "build-pre": "vite build --mode pre",
    "build-live": "vite build --mode live",
    "build-on-windows": "set NODE_OPTIONS=--max-old-space-size=4096 && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "^22.9.1",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.21",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.2.4",
    "tailwindcss-themer": "^2.0.3",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.3"
  }
}
