# Security Environment Variables Template
# Copy this file to .env and update with your actual values

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_at_least_256_bits
TOKEN_PRIVATE_KEY=your_rsa_private_key_here
TOKEN_PUBLIC_KEY=your_rsa_public_key_here
TOKEN_NAME=your_token_name

# Database Configuration
DB_USER=your_db_user
DB_PASS=your_secure_db_password
SURREAL_USER_DB=your_surreal_db_name
USER_NS=your_user_namespace
ADMIN_NS=your_admin_namespace
SPACE_NS=your_space_namespace
ADMIN_DB_NAME=your_admin_db_name

# API Keys (keep these secure!)
UNSPLASH_ACCESS_KEY=your_unsplash_api_key
GOOGLE_GEO_API_KEY=your_google_geo_api_key
DODO_API_KEY=your_dodo_payment_api_key
APPLE_ISSUER_ID=your_apple_issuer_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
APPLE_BUNDLE_ID=your_apple_bundle_id

# OAuth Configuration
VITE_GITHUB_SECRET=your_github_oauth_secret
OAUTH_GOOGLE_SECRET=your_google_oauth_secret
OAUTH_APPLE_SECRET=your_apple_oauth_secret

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Domain and URLs
DOMAIN=yourdomain.com
VITE_BACKEND=https://api.yourdomain.com
VITE_AUTH=your_auth_token

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
DYNAMODB_ACCOUNT_ID=your_dynamodb_account_id
MASTER_DB_TABLE_NAME=your_master_table_name
DYNAMODB_TABLE_PREFIX=your_table_prefix
FILE_BUCKET_PREFIX=your_file_bucket_prefix
TEMP_BUCKET_PREFIX=your_temp_bucket_prefix

# File Upload Security
URL_EXPIRATION_TIME=3600
URL_EXPIRATION_TIME_GET=3600

# Environment
ENV=dev
NODE_ENV=development