{
  "name": "e2e-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:feature": "playwright test --grep @feature",
    "test:regression": "playwright test --grep @regression",
    "test:ci": "playwright test --reporter=line",
    "test:static:nucleum": "node ../../tools/ci/run-playwright-static-product.mjs --product=nucleum --environment=dev --suite=all",
    "test:static:nucleum:smoke": "node ../../tools/ci/run-playwright-static-product.mjs --product=nucleum --environment=dev --suite=smoke --reporter=line",
    "test:static:nucleum:app-smoke": "node ../../tools/ci/run-playwright-static-product.mjs --product=nucleum --environment=dev --suite=app-smoke --reporter=line",
    "coverage:matrix": "tsx scripts/generate-coverage-matrix.ts",
    "debug:impromptu-smoke": "npx tsx scripts/impromptu-surface-smoke.ts",
    "debug:collection-deep-dive": "npx tsx scripts/impromptu-collection-deep-dive.ts",
    "debug:calendar-overview-deep-dive": "npx tsx scripts/impromptu-calendar-overview-deep-dive.ts",
    "debug:focus-analytics-deep-dive": "npx tsx scripts/impromptu-focus-analytics-deep-dive.ts",
    "debug:focus-items-deep-dive": "npx tsx scripts/impromptu-focus-items-deep-dive.ts",
    "debug:goal-collections-lane-deep-dive": "npx tsx scripts/impromptu-goal-collections-lane-deep-dive.ts",
    "debug:goal-record-deep-dive": "npx tsx scripts/impromptu-goal-record-deep-dive.ts",
    "debug:markdown-node-deep-dive": "npx tsx scripts/impromptu-markdown-node-deep-dive.ts",
    "debug:markdown-url-embed-deep-dive": "npx tsx scripts/impromptu-markdown-url-embed-deep-dive.ts",
    "debug:node-collections-lane-deep-dive": "npx tsx scripts/impromptu-node-collections-lane-deep-dive.ts",
    "debug:quick-focus-deep-dive": "npx tsx scripts/impromptu-quick-focus-deep-dive.ts",
    "debug:authfn-account-flow": "npx tsx scripts/impromptu-authfn-account-flow.ts",
    "debug:authfn-settings-logout": "npx tsx scripts/impromptu-authfn-settings-logout.ts",
    "debug:capture-repro": "npx tsx scripts/capture-debug-repro.ts",
    "e2e:save-auth": "npx tsx scripts/save-google-auth-state.ts",
    "e2e:save-auth:nucleum": "PRODUCT=nucleum APP_BASE_URL=https://local.nucleum.app npx tsx scripts/save-google-auth-state.ts",
    "e2e:save-auth:memotron": "PRODUCT=memotron APP_BASE_URL=https://local.memotron.app npx tsx scripts/save-google-auth-state.ts",
    "e2e:save-auth:pointron": "PRODUCT=pointron APP_BASE_URL=https://local.pointron.app npx tsx scripts/save-google-auth-state.ts",
    "e2e:save-email-auth": "npx tsx scripts/save-email-auth-state.ts",
    "e2e:save-email-auth:nucleum": "PRODUCT=nucleum APP_BASE_URL=https://local.nucleum.app npx tsx scripts/save-email-auth-state.ts",
    "e2e:save-email-auth:memotron": "PRODUCT=memotron APP_BASE_URL=https://local.memotron.app npx tsx scripts/save-email-auth-state.ts",
    "e2e:save-email-auth:pointron": "PRODUCT=pointron APP_BASE_URL=https://local.pointron.app npx tsx scripts/save-email-auth-state.ts"
  },
  "dependencies": {
    "@21n/products": "*"
  },
  "devDependencies": {
    "@21n/components": "*",
    "@21n/types": "*",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0"
  }
}
