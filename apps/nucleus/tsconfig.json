{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["../../*"],
      "$lib/*": ["../../*"]
    }
  },
  "exclude": [
    "../../node_modules",
    "../../**/node_modules",
    "../../deployment/**/*",
    "../../server/**/*",
    "../../tests/**/*",
    "../memotron/**/*",
    "../pointron/**/*",
    "build/**/*",
    "dist/**/*",
    ".svelte-kit/**/*",
    "../../packages/static/**/*"
  ]
}
