{
  "name": "@21n/account-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:local": "tsx watch --env-file=.env.local src/node.ts",
    "dev:memory": "tsx src/testing/serve-memory.ts",
    "build": "tsc",
    "start": "node dist/node.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "superfunctions generate-schema --config ./superfunctions.config.mjs --library authfn --adapter drizzle --output ./src/db/generated --force",
    "db:push": "drizzle-kit push --dialect postgresql --schema ./src/db/generated/authfn-schema.ts",
    "db:push:local": "drizzle-kit push --dialect postgresql --schema ./src/db/generated/authfn-schema.ts --url \"$(node --env-file=.env.local -p 'process.env.DATABASE_URL')\"",
    "worker:build": "node scripts/deploy.mjs dev --regions=insouth --dry-run",
    "dev:worker:insouth": "node scripts/dev-multiregion.mjs local --regions=insouth",
    "dev:worker:useast": "node scripts/dev-multiregion.mjs local --regions=useast",
    "dev:worker:euwest": "node scripts/dev-multiregion.mjs local --regions=euwest",
    "dev:worker:multi": "node scripts/dev-multiregion.mjs local",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "deploy:pre": "node scripts/deploy.mjs pre",
    "deploy:live": "node scripts/deploy.mjs live",
    "routes:dev": "node scripts/sync-routes.mjs dev",
    "routes:pre": "node scripts/sync-routes.mjs pre",
    "routes:live": "node scripts/sync-routes.mjs live",
    "waf:dev": "node scripts/sync-waf-exceptions.mjs dev",
    "waf:pre": "node scripts/sync-waf-exceptions.mjs pre",
    "waf:live": "node scripts/sync-waf-exceptions.mjs live",
    "secrets:sync:dev": "node scripts/sync-secrets-store.mjs dev",
    "secrets:sync:pre": "node scripts/sync-secrets-store.mjs pre",
    "secrets:sync:live": "node scripts/sync-secrets-store.mjs live",
    "openapi:account": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" apifn import openapi http://127.0.0.1:${PORT:-8787}/openapi.json --output ./.apifn/generated --base-url http://127.0.0.1:${PORT:-8787} --env local --force",
    "test:e2e:apifn:memory": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" tsx src/testing/run-apifn-memory.ts",
    "test:e2e:apifn:multiregion": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" tsx src/testing/run-apifn-multiregion.ts",
    "test:e2e:apifn:ratelimit": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" tsx src/testing/run-apifn-ratelimit.ts",
    "test:otp-linking": "tsx src/testing/run-otp-linking-regression.ts",
    "test:e2e:apifn:postgres": "test -n \"$ACCOUNT_E2E_BASE_URL\" && NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" apifn test .apifn/account --env memory --env-var baseUrl=$ACCOUNT_E2E_BASE_URL --output .apifn/results/postgres.json",
    "test:e2e:apifn:dynamodb": "test -n \"$ACCOUNT_E2E_BASE_URL\" && NODE_OPTIONS=\"${NODE_OPTIONS:-} --preserve-symlinks\" apifn test .apifn/account --env memory --env-var baseUrl=$ACCOUNT_E2E_BASE_URL --output .apifn/results/dynamodb.json"
  },
  "dependencies": {
    "@21n/data": "*",
    "@21n/shared-data": "*",
    "@authfn/api-keys": "0.1.1",
    "authfn": "0.2.0",
    "@authfn/email-otp": "0.1.1",
    "@authfn/multi-region": "0.1.1",
    "@authfn/native-handoff": "0.1.1",
    "@authfn/password": "0.1.1",
    "@authfn/social-oauth": "0.1.1",
    "@authfn/two-factor": "0.1.1",
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1037.0",
    "@datafn/client": "0.1.0",
    "@datafn/core": "0.1.0",
    "@datafn/server": "0.1.0",
    "@hono/node-server": "^1.14.1",
    "@logfn/core": "0.1.0",
    "@searchfn/adapter-opensearch": "0.1.0",
    "@searchfn/adapter-contracts": "0.4.0",
    "@searchfn/adapter-elasticsearch": "0.1.0",
    "@searchfn/adapter-memory": "0.1.0",
    "@searchfn/core": "0.3.0",
    "@searchfn/datafn-provider": "0.4.0",
    "@secfn/core": "0.0.1",
    "@secfn/server": "0.0.1",
    "@superfunctions/auth": "0.2.0",
    "@superfunctions/delivery": "0.1.0",
    "@superfunctions/db": "0.2.0",
    "@superfunctions/http": "0.2.0",
    "@superfunctions/http-openapi": "0.1.0",
    "@superfunctions/middleware": "0.2.0",
    "@superfunctions/oauth-core": "0.1.0",
    "@superfunctions/oauth-flow": "0.1.0",
    "@superfunctions/oauth-http": "0.1.0",
    "@superfunctions/oauth-providers": "0.1.0",
    "@superfunctions/oauth-storage": "0.1.0",
    "@superfunctions/observability": "0.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.10",
    "jose": "^5.10.0",
    "postgres": "^3.4.8",
    "sendfn": "0.0.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@apifn/cli": "0.0.2",
    "@apifn/collections": "0.0.2",
    "@apifn/core": "0.0.2",
    "@apifn/mock": "0.0.2",
    "@apifn/snippets": "0.0.3",
    "@cloudflare/workers-types": "^4.20260423.0",
    "@datafn/cli": "0.1.0",
    "@superfunctions/cli": "0.2.0",
    "@testfn/core": "^0.0.2",
    "@types/node": "^22.0.0",
    "cac": "^6.7.14",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "glob": "^11.1.0",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.85.0",
    "yaml": "^2.8.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
