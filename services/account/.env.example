NODE_ENV=development
PORT=8787
LOG_LEVEL=debug

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nucleus_account
ACCOUNT_DB_POOL_SIZE=5

DATAFN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nucleus_datafn_sync
DATAFN_DB_POOL_SIZE=5
DATAFN_MAX_PAYLOAD_BYTES=5242880
DATAFN_OPENSEARCH_URL=http://127.0.0.1:9200
DATAFN_OPENSEARCH_INDEX_PREFIX=nucleum_local_insouth
# DATAFN_OPENSEARCH_USERNAME=
# DATAFN_OPENSEARCH_PASSWORD=
# DATAFN_OPENSEARCH_API_KEY=
# DATAFN_OPENSEARCH_REQUEST_TIMEOUT_MS=30000
# DATAFN_OPENSEARCH_MAX_RETRIES=2

ACCOUNT_REGION_ID=insouth
ACCOUNT_AUTHORITY=https://account-insouth-local.nucleum.app
ACCOUNT_COOKIE_DOMAIN=.nucleum.app
ACCOUNT_CORS_ORIGINS=https://local.nucleum.app,https://local.memotron.app,https://local.pointron.app,tauri://localhost
# Optional when running multiple regional account services or product account domains.
# Keep all product-owned account hosts here so cookies are scoped to the request product domain.
# ACCOUNT_REGIONS_JSON=[{"regionId":"insouth","authority":"https://account-insouth-local.nucleum.app","hosts":["account-insouth-local.nucleum.app"],"domain":".nucleum.app","cookie":{"domain":".nucleum.app"}},{"regionId":"insouth","authority":"https://account-insouth-local.memotron.app","hosts":["account-insouth-local.memotron.app"],"domain":".memotron.app","cookie":{"domain":".memotron.app"}},{"regionId":"insouth","authority":"https://account-insouth-local.pointron.app","hosts":["account-insouth-local.pointron.app"],"domain":".pointron.app","cookie":{"domain":".pointron.app"}},{"regionId":"useast","authority":"https://account-useast-local.nucleum.app","hosts":["account-useast-local.nucleum.app"],"domain":".nucleum.app","cookie":{"domain":".nucleum.app"}},{"regionId":"useast","authority":"https://account-useast-local.memotron.app","hosts":["account-useast-local.memotron.app"],"domain":".memotron.app","cookie":{"domain":".memotron.app"}},{"regionId":"useast","authority":"https://account-useast-local.pointron.app","hosts":["account-useast-local.pointron.app"],"domain":".pointron.app","cookie":{"domain":".pointron.app"}},{"regionId":"euwest","authority":"https://account-euwest-local.nucleum.app","hosts":["account-euwest-local.nucleum.app"],"domain":".nucleum.app","cookie":{"domain":".nucleum.app"}},{"regionId":"euwest","authority":"https://account-euwest-local.memotron.app","hosts":["account-euwest-local.memotron.app"],"domain":".memotron.app","cookie":{"domain":".memotron.app"}},{"regionId":"euwest","authority":"https://account-euwest-local.pointron.app","hosts":["account-euwest-local.pointron.app"],"domain":".pointron.app","cookie":{"domain":".pointron.app"}}]

AUTHFN_NAMESPACE=nucleus_account
AUTHFN_CACHE_PREFIX=authfn:nucleus_account:
AUTHFN_COOKIE_PREFIX=nucleus
AUTHFN_COOKIE_SECURE=true

# Leave RESEND_API_KEY unset only when ACCOUNT_EMAIL_LOCAL_DELIVERY=true.
ACCOUNT_EMAIL_LOCAL_DELIVERY=true
# RESEND_API_KEY=
# ACCOUNT_EMAIL_FROM accepts either a bare email or a sender string.
ACCOUNT_EMAIL_FROM=Nucleum <accounts@nucleum.app>
# Optional when ACCOUNT_EMAIL_FROM is a bare email.
ACCOUNT_EMAIL_FROM_NAME=

# Optional: only needed for real multi-region lookup.
# AUTHFN_REGION_LOOKUP_TABLE=nucleus-auth-region-lookup
# AWS_REGION=us-east-1
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# Optional OAuth.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URIS=https://account-insouth-local.nucleum.app/auth/social/callback/google,https://account-insouth-local.memotron.app/auth/social/callback/google,https://account-insouth-local.pointron.app/auth/social/callback/google
# GOOGLE_OAUTH_RETURN_TO=https://local.nucleum.app,nucleum://oauthsignin,memotron://oauthsignin,pointron://oauthsignin
